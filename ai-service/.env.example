APP_ENV=local

# Must match AI_SERVICE_TOKEN in the Laravel .env
INTERNAL_TOKEN=

OPENAI_API_KEY=
CHAT_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small

# Where the notes vector store (Chroma) keeps its files
CHROMA_PATH=storage/chroma
REDIS_URL=redis://localhost:6379/0

LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
