APP_ENV=local

# Must match AI_SERVICE_TOKEN in the Laravel .env
INTERNAL_TOKEN=

OPENAI_API_KEY=
CHAT_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small

# Notes vector store (Qdrant server). Locally: qdrant.exe or Docker; API key only needed on the server.
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
EMBEDDING_DIMENSIONS=1536
# The assistant reads contacts from the Laravel app (its /internal API, with INTERNAL_TOKEN)
LARAVEL_URL=http://127.0.0.1:8000
# Prompt variant: baseline | structured | grounded
ASSISTANT_PROMPT=grounded

REDIS_URL=redis://localhost:6379/0

LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
